# ==========================================
# BulkMailer Frontend Environment Variables
# ==========================================

# Base URL of the backend API
# If frontend and backend are hosted on the same origin / domain (or reverse proxied),
# leave this empty to use relative /api paths.
# If frontend and backend are hosted on different domains, provide the backend live URL:
# e.g., https://api.yourdomain.runs-on.dev or https://bulkmailer-api.onrender.com
VITE_API_URL=http://localhost:5000
