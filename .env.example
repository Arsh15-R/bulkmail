# ==========================================
# BulkMailer Environment Configuration (.env)
# ==========================================

# ------------------------------------------
# Server & Production Network Settings
# ------------------------------------------
# Port for the Node.js backend (in production, cloud hosts inject this automatically)
PORT=5000

# Allowed Frontend URL for CORS (comma-separated for multiple origins, e.g. https://[LIVE URL])
FRONTEND_URL=http://localhost:5173

# Public Base URL of this backend service (used for tracking pixels, clicks, and unsubscribe links in sent emails)
APP_BASE_URL=http://localhost:5000

# ------------------------------------------
# Security & Authentication
# ------------------------------------------
# Strong, cryptographically random secret string used to sign JWT authentication tokens (min 32 chars)
JWT_SECRET=replace_with_a_secure_random_32_character_string_for_production

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# Supported database providers: 'sqlite' (default) or 'firebase'
DATABASE_PROVIDER=sqlite

# Path to SQLite database file.
# Note: On hosting platforms (Render, Railway, Fly), set this to a mounted persistent volume path
# (e.g. /data/bulkmailer.db or /mnt/data/bulkmailer.db) so data survives app restarts and re-deploys.
DB_PATH=./data/bulkmailer.db

# Optional: Persistent path for uploaded attachments
UPLOADS_DIR=./uploads

# ------------------------------------------
# Firebase Firestore Configuration (Optional)
# ------------------------------------------
# Only required if DATABASE_PROVIDER is set to 'firebase'
# Option 1: Path to Firebase Admin service account JSON
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# Option 2: Individual Firebase environment variables
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBA...your_private_key...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# ------------------------------------------
# Email SMTP Provider Settings
# ------------------------------------------
# Options: 'smtp' (live email sending) or 'mock' (local testing simulation without sending)
EMAIL_PROVIDER=smtp

# SMTP server host (e.g. smtp.gmail.com, smtp.sendgrid.net, smtp.mailgun.org)
SMTP_HOST=smtp.gmail.com

# SMTP port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# Set to true only if using port 465 (SSL); false for 587 (STARTTLS)
SMTP_SECURE=false

# Your email account or SMTP username
SMTP_USER=your_email@gmail.com

# Your email App Password (e.g. 16-character Google App Password) or SMTP relay password
SMTP_PASS=your_16_character_app_password

# Default 'From' header displayed to recipients in emails
EMAIL_FROM="BulkMailer Dispatcher" <your_email@gmail.com>

# ------------------------------------------
# Deliverability & Rate Limiting Safeguards
# ------------------------------------------
# Delay between individual email dispatches in milliseconds (500ms prevents spam throttling)
DELAY_BETWEEN_EMAILS_MS=500

# Maximum number of emails a user can send per 24 hours (protects sender reputation)
DAILY_SEND_LIMIT=500
